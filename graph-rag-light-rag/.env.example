# Copy to .env and fill in. All values here are read by src/finrag/config.py.

# --- Anthropic (the only LLM provider; see llm.py) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Neo4j (docker-compose brings this up on localhost:7687) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- EDGAR requires a User-Agent identity string: "Your Name your.email@example.com" ---
EDGAR_IDENTITY=Your Name you@example.com

# --- Model overrides (all default to claude-opus-4-8 in config.py) ---
# FINRAG_ANSWER_MODEL=claude-opus-4-8
# FINRAG_EXTRACT_MODEL=claude-opus-4-8
# FINRAG_JUDGE_MODEL=claude-opus-4-8
